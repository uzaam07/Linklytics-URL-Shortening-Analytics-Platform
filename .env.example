# Set a strong random secret in production; never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
FLASK_DEBUG=0
# Optional persistent database path, e.g. /var/data/linklytics.db
# LINKLYTICS_DATABASE=/var/data/linklytics.db
# Keep disabled unless testing the demo-only plan toggle locally.
ALLOW_DEMO_PLAN_UPGRADE=0
# Optional shared rate limiter for multi-worker deployments.
REDIS_URL=
TRUST_PROXY=0
# Public app URL, used for Stripe Checkout return URLs.
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Stripe test-mode credentials. Create a recurring Price in Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
